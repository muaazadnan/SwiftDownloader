{
  "manifest_version": 2,
  "name": "SwiftDownloader",
  "description": "Send downloads to SwiftDownloader — Free. Fast. Unlimited.",
  "version": "1.0.0",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "notifications",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "SwiftDownloader"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "swiftdownloader@swiftdownloader.org",
      "strict_min_version": "91.0"
    }
  }
}
